# Development Supabase project only. Never point local work at production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy key name remains supported by the client if your project has not migrated.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed for narrowly scoped RPC submissions. Never use NEXT_PUBLIC_ here.
SUPABASE_SERVICE_ROLE_KEY=
# Use the deployed origin in production and allow its /auth/callback URL in Supabase Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Use a random secret unique to each environment for privacy-preserving IP rate-limit hashes.
IP_HASH_SALT=
# Optional bot protection/email delivery integration; configure only after obtaining credentials.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# Business identity and WhatsApp number are configured after owner verification.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_ENABLE_SHORT_LET=false
